# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit file chứa bí mật.

# Postgres (Neon). Dùng chuỗi "pooled" cho ứng dụng.
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Chuỗi "unpooled" cho migration (tùy chọn).
DATABASE_URI_UNPOOLED=

# Chuỗi ngẫu nhiên dài (>= 32 ký tự) để ký phiên đăng nhập Payload.
PAYLOAD_SECRET=

# URL công khai của site (canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Form lead (Phase 4)
# Turnstile: khóa bí mật (server) + khóa site (public). Thiếu khóa bí mật ở production thì form bị chặn.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Gmail SMTP: dùng App Password (không dùng mật khẩu Gmail). LEADS_NOTIFY_TO mặc định = SMTP_USER.
SMTP_USER=
SMTP_PASSWORD=
LEADS_NOTIFY_TO=
# GTM chỉ tải sau khi người dùng bấm "Chấp nhận" ở banner cookie.
NEXT_PUBLIC_GTM_ID=
