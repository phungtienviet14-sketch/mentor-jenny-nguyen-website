# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit file chứa bí mật.

# Postgres (Neon). Dùng chuỗi "pooled" cho ứng dụng.
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Chuỗi "unpooled" cho migration (tùy chọn).
DATABASE_URI_UNPOOLED=

# Chuỗi ngẫu nhiên dài (>= 32 ký tự) để ký phiên đăng nhập Payload.
PAYLOAD_SECRET=

# URL công khai của site (canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4 (chưa dùng): Turnstile, Gmail SMTP (App Password), GA4/GTM.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SMTP_USER=
# SMTP_PASSWORD=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA_ID=
